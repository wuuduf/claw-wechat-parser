# Copy to .env and edit if needed.
TZ=Asia/Shanghai

# Keep 0:0 for the simplest bind-mounted ./data permissions on VPS.
# If you change this to a non-root uid/gid, run: chown -R <uid>:<gid> ./data
PUID=0
PGID=0

# Small VPS friendly defaults
CLAW_PARSER_MAX_MEDIA_SIZE_MB=60
CLAW_PARSER_MAX_MEDIA_DURATION_S=600
CLAW_PARSER_DEBOUNCE_SECONDS=300
CLAW_PARSER_CACHE_MAX_GB=4

# Bilibili options
CLAW_PARSER_BILIBILI_VIDEO_QUALITY=_720P
CLAW_PARSER_BILIBILI_VIDEO_CODECS=AVC

# Optional cookies. Leave empty unless a platform needs login/cookies.
CLAW_PARSER_BILIBILI_COOKIE=
CLAW_PARSER_DOUYIN_COOKIE=
CLAW_PARSER_XHS_COOKIE=
CLAW_PARSER_INSTAGRAM_COOKIE=
CLAW_PARSER_YOUTUBE_COOKIE=
CLAW_PARSER_TWITTER_COOKIE=
